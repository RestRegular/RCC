// 2026-11-18 用户裁决 A：闭包按引用捕获，修改要写回外层。
//
// 修前这是「按值捕获、不写回」：闭包内的 n += 1 只改环境副本，
// 外层 n 始终是 0，且每次调用都从捕获时的值重新开始
// （连调三次输出 1 1 1）。这是静默错值 —— 计数器永远停在 1，
// 而且没有任何报错。
fun makeCounter(): func[][int] {
    var n: int = 0
    ret () -> {
        n += 1
        ret n
    }
}
fun main(): void {
    var c = makeCounter()
    sout(c())
    sout(c())
    sout(c())
}
main()
