// unlink_all 清空某对象的所有 Link 字段，两端同步
class U {
    var v: int
    var peers: Link[U][peers][many]
    ctor(x: int) { this.v = x }
}
fun main(): void {
    var pl = Pool.chunked(4)
    var a: U pl = pl.new[U](1)
    var b: U pl = pl.new[U](2)
    var c: U pl = pl.new[U](3)
    a.peers.add(b)
    c.peers.add(a)
    sout(a.peers.count())
    a.unlink_all()
    sout(a.peers.count())
    sout(b.peers.count())
    sout(c.peers.count())
}
main()
