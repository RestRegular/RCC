// 正向：scope 内两个 spawn，块末 join，两个跨线程 free 计数平衡

fun work(p: ptr): void {
    core_mem_set(p, 7, 8)
    core_free(p)
}

fun main(): void {
    core_dbg_reset()
    var a: ptr = core_alloc(16, 8)
    var b: ptr = core_alloc(16, 8)
    scope s {
        s.spawn(work(a))
        s.spawn(work(b))
        sout("in scope")
    }
    sout("after join")
    sout(core_dbg_allocations())
    sout(core_dbg_frees())
}
main()
