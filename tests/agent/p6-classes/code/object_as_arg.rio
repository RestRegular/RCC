fun sout(*args: any, end="\n"): void { encapsulated }
class Point {
    var x: int, y: int
    ctor(a: int, b: int) {
        this.x = a
        this.y = b
    }
    fun sum(): int { ret this.x + this.y }
}
fun total(p: Point): int {
    ret p.sum()
}
fun main(): void {
    var p = Point(8, 9)
    sout(total(p))
}
main()