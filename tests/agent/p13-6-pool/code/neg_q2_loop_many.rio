// P13-6 完整化（§6.3 循环中动态加入 -> many）：循环内一条 push 每轮都执行，
// 单遍 codegen 只扫到一次也必须按 many 饱和，release 诊断显示 mult=many。
import ds = "ds"
class Player { var name: str  ctor(n: str) { this.name = n } }
fun main(): void {
    var pl = Pool.fixed(8)
    var a: Player pl = Player("bob")
    var team: list[Player] = []
    var i = 0
    while i < 3 {
        ds.listAppend(team, a)
        i = i + 1
    }
    a.clear()
    pl.release(a)
}
main()
