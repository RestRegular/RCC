// Q1: chunked 档真实池内分配，多块追加，字段读写正常，槽地址稳定
class Player { var name: str  var hp: int  ctor(n: str, h: int) { this.name = n  this.hp = h } }
fun main(): void {
    var pl = Pool.chunked(block: 2)
    var a: Player pl = pl.new[Player]("a", 10)
    var b: Player pl = pl.new[Player]("b", 20)
    var c: Player pl = pl.new[Player]("c", 30)   // 开新块，旧槽不动
    sout(a.name)
    sout(b.hp)
    sout(c.name)
    a.hp = 99
    sout(a.hp)
}
main()
