import stdio

class ID {
    var _number: int static = 0, num: int

    ctor () {
        this._number = this._number + 1
        this.num = this._number
    }
}

class Object {
    var x: int, id: ID

    ctor (x: int) {
        this.x = x
        this.id = ID()
    }

    fun print(): void {
        sout("[Object(", this.id.num, "): ", this.x, "]")
    }
}

for ({var i = 0; i < 1000; i ++}) {
    var o: Object = Object(i)
    o.print()
}