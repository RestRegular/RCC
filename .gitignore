/release/exes/
/release/Release/
/release/RCC.exe
/test/txt/
/test/dll/

# 构建产物
/build/
# core 层目标文件由 CMake 从 core_win64.s 自动生成
/release/lib/core/*.o
# rt 层由 CMake 从 lib/rt/rt.rio 自举编译生成（.s/.o/.exe 都是产物）
/release/lib/rt/
# 仓库根 lib/ 下的 rt 编译产物（源文件 rt.rio / core.rio / core_win64.s 要跟踪）
/lib/rt/*.s
/lib/rt/*.o
/lib/rt/*.exe
# P0 测试临时目录
/build/p0_test/
# 本地运行时 DLL（MinGW 动态链接所需，不随仓库分发）
/release/*.dll
# DSH 会话本地状态
/.dsh/
# 手动编译 tests/ 下用例留下的中间产物
/tests/*.exe
/tests/*.o
/tests/*.s
# std 层：唯一真相是 lib/std/*.rio，release/Lib/builtin/ 下对应的文件由 CMake
# 拷贝生成。签进仓库会让"改了源码但忘了重新拷"这类漂移无法被构建发现。
# 逐文件列出而不是整目录忽略：datatype / stdio 是旧架构遗留文件，已随 S3
# 整模块删除并从仓库移除（P12-3-C，提交 30b4914）。
/release/Lib/builtin/math.rio
/release/Lib/builtin/ops.rio
/release/Lib/builtin/prog.rio
/release/Lib/builtin/str.rio
/release/Lib/builtin/io.rio
/release/Lib/builtin/ds.rio
/release/Lib/builtin/.stamp