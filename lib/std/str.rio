/*
 * str.rio —— 字符串操作模块
 *
 * ============================ 实现约束（重要） ============================
 * 新架构是静态的、值内联的：没有装箱、没有运行期类型标签、没有指针解引用
 * 运算符。这决定了本模块的实现手段，也决定了少数旧 API 的语义必须调整。
 *
 *  1) 没有解引用运算符 `*p`，但**指针算术 + core_mem_copy/core_mem_set 可用**。
 *     所以「从 str 切一段出来」= 分配缓冲区 + 拷字节 + 写长度头。
 *     这是本模块的主力手段，比旧版「逐字符 setType 再拼接」高效且正确
 *     （旧版遇到 UTF-8 多字节字符会切坏，新版按字节切，天然安全）。
 *  2) str 布局（ABI v2，P13-1）= {i64 len, i64 cap} + bytes。
 *     len 在 +0（8 字节小端），cap 在 +8，内容在 +16。
 *     cap == 0 表示静态只读头（字面量），不可释放（D11 裁决 A）。
 *     core_mem_set 只写低 8 位，所以长度头必须**逐字节写**（见 _strSetLen）。
 *  3) `s[i]` 读出的是 **char**（单个字节的字符值），不是 int 也不是 str。
 *     char 是完整可用的一等类型：`sout(char)` 走 rt_print_char 打印字符，
 *     `toStr(char)` 可转 str，`var i: int = c` 可隐式拓宽成 int。
 *     但 char **不能**直接传给 `str` 形参（跨族报错），`str + char` 拼接
 *     目前也有缺陷（输出垃圾值，与 char 无关，是 str 拼接数值的既有 bug）。
 *  4) 不依赖 datatype 模块（已按 S3 整模块删除）。
 *  5) `str + str` 是拼接（G3），`==` 按内容比较（G9），`s[i]` 可读（G10）。
 *
 * ============================ 与旧版的语义差异 ============================
 * 旧 str.rio 靠 `dt.setType` 在运行时改写值的类型标签，新架构没有这个能力。
 * 以下函数的**语义被重新定义**，这是语言能力决定的，不是实现不完整：
 *
 *  - `toChar(arg)`：返回**首个字节的 ASCII 码（int）**。
 *    旧版返回 char，且对长度≠1 的输入返回 `0`（`toChar("\000")`）；
 *    新版改为「直接取首字节」，所以必须返回 int 才能表达越界情形。
 *  - `intToChar(i)`：返回 **char**（与原仓库一致）。
 *    （曾一度改成返回 int，理由是「char 无法使用」——该理由经实测证伪，
 *      char 是完整可用的一等类型，故已恢复。）
 *  - `charToInt(c)`：接受 int / char / str，返回 int。
 *    str 重载要求**长度恰为 1**，否则抛错 —— 旧实现 `charToInt("true")`
 *    会静默返回首字节 116，是错误行为。
 *  - `toLowerCase` / `toUpperCase(data: str)`：只接受 str，返回 str。
 *    旧版还接受 char/int 做 ASCII 运算，但结果类型无处安放（见上），
 *    那两个重载无法表达，已移除。
 *  - `toStr(arg)`：**真正做转换**，用重载按类型分派（int/float/bool/str/char）。
 *    旧版是「把值的类型标签改成 str」（本质是欺骗类型系统），不是转换。
 * ==========================================================================
 */

// ============================ 内部工具 ============================
//
// 命名约定：模块私有的辅助函数一律带 `_<模块名>` 前缀。
// 原因：模块是**编译期内联**的，被 import 的模块语句会原地展开到导入者
// 的同一命名空间里（rcc_module_loader 的 expandProgram）。所以
// `str.rio` 的 `_setLen` 和 `io.rio` 的 `_setLen` 在同一程序里会撞名，
// 报 `Duplicate definition of overloaded function '_setLen' with the same
// parameter types`。加上模块前缀才能让多个模块共存。

// 逐字节写 8 字节小端长度头。
// core_mem_set(p, n, 1) 只写 n 的低 8 位 —— 长度 > 255 时会截断成
// n % 256，实测 mkStr(300) 得到 len=44。必须逐字节写。
fun _strSetLen(p: ptr, n: int) {
    var i: int = 0
    while i < 8 {
        core_mem_set(p + i, (n / _strPow256(i)) % 256, 1)
        i += 1
    }
}

fun _strPow256(k: int): int {
    var r: int = 1
    var i: int = 0
    while i < k {
        r = r * 256
        i += 1
    }
    ret r
}

// 分配长度为 n 的 str 缓冲区（内容未初始化），长度头与 cap 已写对。
// 多分配 32 字节：16 字节头（len + cap）+ 内容 + 末尾留 0（C 字符串兼容）。
//
// cap 必须写成 **n**（不是 0）：这里分配的是堆内存，将来要被 core_free
// 释放；而 cap == 0 是「静态只读、不可释放」的标记（D11）。
// 返回类型是 **str** 而不是 ptr：这个函数分配的是一块完整的 str 缓冲区，
// 所有权从分配点直接落到调用方手里。
//
// 返回 ptr 的话，按 D14「ptr 不承担所有权」，`var r: str = p` 只能得到
// 借用视图，`ret r` 就会被 D9 规则 C 拦下 —— 实测 _strSlice /
// toLowerCase / toUpperCase 三处全部编译不过；而反过来让 ptr 转移所有权，
// `var slot: str = scratch` 之后 `slot = scratch` 就会把同一个堆块先 free
// 再写回，下一轮读是 use-after-free（str 的 dict toStr 就是这么崩的）。
// 让分配点直接产出 str，两个坑都不存在。
fun _strNew(n: int): str {
    var p: str = core_alloc(n + 32, 8)
    _strSetLen(p, n)
    _strSetCap(p, n)
    core_mem_set(p + 16 + n, 0, 1)
    ret p
}

// 写 cap 字段（偏移 +8）。同样是逐字节写，理由见 _strSetLen。
fun _strSetCap(p: ptr, n: int): void {
    var i: int = 0
    while i < 8 {
        core_mem_set(p + 8 + i, (n / _strPow256(i)) % 256, 1)
        i += 1
    }
}

// 取 src 从 i 开始的 n 个字节，构造新 str。
// 这是「没有解引用运算符」时构造字符串的通用手段。
fun _strSlice(src: str, i: int, n: int): str {
    var p: str = _strNew(n)
    core_mem_copy(p + 16, src + 16 + i, n)
    ret p
}

// ============================ 长度 ============================

// 字节长度。str/list/dict 的长度字段都在偏移 0，所以对三者通用。
// 与 ds.size 同一个手段；str 模块自带一份以避免模块间循环依赖。
//
// 形参必须标 `any`：不标注会被当成 int，传 str 时在调用点就报
// "cannot assign a value of type str to a target of type int"。
// `any` 在这里是「接受任意指针族值」的意思（str/list/dict 都是 8 字节指针），
// 不是运行期类型标签 —— 长度字段都在 +0，所以对三者都成立。
fun size(arg: any): int {
    ret core_str_len(arg)
}

// ============================ 数值 → 字符串 ============================

// 逐位取模，用查表把数字变成 str，再反转拼接。
// 不用 10 个 elif 分支，是因为分支会让 8 行代码膨胀成 40 行且容易漏。
fun _strDigits(x: int): str {
    var tbl: str = "0123456789"
    var acc: str = ""
    var v: int = x
    while v > 0 {
        var d: int = v % 10
        // 从 tbl 里取第 d 个字符：拷 1 字节到新缓冲区再当 str 用。
        var one: str = _strSlice(tbl, d, 1)
        acc = one + acc
        v = v / 10
    }
    ret acc
}

fun intToStr(v: int): str {
    if v == 0 {
        ret "0"
    }
    if v < 0 {
        ret "-" + _strDigits(0 - v)
    }
    ret _strDigits(v)
}

fun floatToStr(v: float): str {
    var ip: int = v
    var head: str = intToStr(ip)
    var frac: float = v - ip
    if frac < 0.0 {
        frac = 0.0 - frac
    }
    if frac <= 0.0 {
        // 整数形态的 float 也要带 ".0"：否则 toStr(1.0) 和 toStr(1)
        // 输出一模一样，浮点类型信息就丢了。
        ret head + ".0"
    }
    // 最多 6 位小数，去掉尾部 0（3.14 应输出 "3.14" 而不是 "3.140000"）。
    var fracStr: str = ""
    var n: int = 0
    var f: float = frac
    while n < 6 {
        f = f * 10.0
        var d: int = f
        var tbl: str = "0123456789"
        fracStr += _strSlice(tbl, d, 1)
        f = f - d
        n += 1
        if f <= 0.0 {
            break
        }
    }
    // 去掉尾部 0
    var len: int = core_str_len(fracStr)
    while len > 0 {
        if fracStr[len - 1] == 48 {
            len -= 1
        } else {
            break
        }
    }
    if len == 0 {
        ret head + ".0"
    }
    ret head + "." + _strSlice(fracStr, 0, len)
}

// 任意标量 → str。用重载按静态类型分派 —— 泛型做不到类型分派
// （T 是单一类型，无法在函数体里区分 int/float），any 会截断 float。
fun toStr(arg: int): str {
    ret intToStr(arg)
}

fun toStr(arg: float): str {
    ret floatToStr(arg)
}

fun toStr(arg: bool): str {
    if arg {
        ret "true"
    }
    ret "false"
}

fun toStr(arg: str): str {
    // D9 规则 C：形参是**借用**，借用不能 ret（调用方拥有那个值，直接返回
    // 会让两边都以为自己在管这块内存）。规范 §11 给的合法手段就是显式深拷贝：
    // 「拷贝用显式 clone()」。core_clone_str 是 core 层已冻结的克隆原语
    // （core.rio / core_win64.s），返回一个**新分配**、可释放的 str 头，
    // 语义上与原串内容相同、所有权独立 —— 不需要放宽任何借用规则。
    ret core_clone_str(arg)
}

fun toStr(arg: char): str {
    // char 无法直接转 str（无转换机制），按字节值走 int 分支。
    var b: int = arg
    ret intToStr(b)
}

fun toStr[T](arg: list[T]): str {
    var n = size(arg), res = "["
    for ({var i = 0; i < n; i ++}) {
        res += toStr(arg[i])
        if i < n - 1 {
            res += ", "
        }
    }
    ret res + "]"
}

fun toStr[T, K](arg: dict[T, K]): str {
    var scratch: ptr = core_alloc(64, 8)
    var n = size(arg), res = "{"
    var i = 0
    while i < n {
        // keys[i]。ABI v2 布局：DictHeader { len@0, cap@8, ptr keys@16, ptr vals@24 }
        core_mem_set(scratch, 8, 1)
        core_mem_copy(scratch + 16, arg + 16, 8)
        var slot: str = scratch
        var keys: int = 0
        var j = 7
        while j >= 0 {
            var c: char = slot[j]
            var b: int = c
            keys = keys * 256 + b
            j -= 1
        }

        core_mem_set(scratch, 8, 1)
        core_mem_copy(scratch + 16, keys + i * 8, 8)
        slot = scratch
        var kp: int = 0
        j = 7
        while j >= 0 {
            var c2: char = slot[j]
            var b2: int = c2
            kp = kp * 256 + b2
            j -= 1
        }
        var kptr: ptr = kp
        var key: T = kptr
        res += toStr(key) + ": " + toStr(arg[key])
        if i < n - 1 {
            res += ", "
        }
        i += 1
    }
    ret res + "}"
}

// ============================ 字符 ↔ 整数 ============================

// 取首个字节的 ASCII 码。签名从 char 改成 int，理由见文件头。
fun toChar(arg: str): int {
    if core_str_len(arg) == 0 {
        ret 0
    }
    ret arg[0]
}

fun toChar(arg: int): int {
    ret arg
}

fun charToInt(c: int): int {
    ret c
}

fun charToInt(c: char): int {
    ret c
}

// 长度检查只能在运行时做：`size()` 包装的是 core_str_len（外部符号），
// 且编译器目前没有常量折叠，字面量长度也拿不到。
// 将来常量折叠落地（已登记为「优化开发阶段」的待办）后，这个检查可自然
// 提前到编译期 —— 届时**不要**改成在 codegen 里特化 charToInt，那会破坏
// 「stdlib 是纯 Rio 源码」的分层（用户 2026-11-16 明确否决该方案）。
fun charToInt(s: str): int {
    if size(s) != 1 {
        throw "charToInt: expected exactly one character"
    }
    ret charToInt(s[0])
}

fun intToChar(i: int): char {
    ret i
}

// ============================ 子串与查找 ============================

fun subStr(content: str, startIndex: int = 0, length: int = -1): str {
    var contentLen: int = core_str_len(content)
    if startIndex < 0 {
        startIndex = 0
    }
    if startIndex >= contentLen {
        ret ""
    }
    var n: int = contentLen - startIndex
    if length >= 0 && length < n {
        n = length
    }
    if n <= 0 {
        ret ""
    }
    ret _strSlice(content, startIndex, n)
}

fun find(content: str, part: str, startIndex: int = 0): int {
    var contentLen: int = core_str_len(content)
    var partLen: int = core_str_len(part)
    if partLen == 0 {
        ret startIndex
    }
    var i: int = startIndex
    if i < 0 {
        i = 0
    }
    while i + partLen <= contentLen {
        var ok: bool = true
        var j: int = 0
        while j < partLen {
            if content[i + j] != part[j] {
                ok = false
                break
            }
            j += 1
        }
        if ok {
            return i
        }
        i += 1
    }
    ret -1
}

// ============================ 大小写 ============================

// 只处理 ASCII。UTF-8 多字节字符原样保留（按字节拷贝，不会切坏）。
fun toLowerCase(data: str): str {
    var n: int = core_str_len(data)
    var p: str = _strNew(n)
    var i: int = 0
    while i < n {
        var b: int = data[i]
        if b >= 65 && b <= 90 {
            b = b + 32
        }
        core_mem_set(p + 16 + i, b, 1)
        i += 1
    }
    ret p
}

fun toUpperCase(data: str): str {
    var n: int = core_str_len(data)
    var p: str = _strNew(n)
    var i: int = 0
    while i < n {
        var b: int = data[i]
        if b >= 97 && b <= 122 {
            b = b - 32
        }
        core_mem_set(p + 16 + i, b, 1)
        i += 1
    }
    ret p
}

// ============================ 替换 ============================

fun replace(content: str, old: str, new: str, once: bool = false): str {
    if core_str_len(old) == 0 {
        // 没有可替换的东西 = 原样返回。形参是借用，不能直接 ret（D9 规则 C），
        // 按规范 §11 用显式 clone 把「借来的值」变成「自己拥有的新值」。
        ret core_clone_str(content)
    }
    var res: str = ""
    // rest 必须是**拥有者**而不是 content 的别名：`var rest: str = content`
    // 是壳子赋值，rest 会降级成借用（D9 规则 C），循环 0 次迭代时它还是
    // 借用，后面 `ret res + rest` 就把借用带出了函数。用 clone 拿一份自己
    // 拥有的副本（规范 §11「拷贝用显式 clone()」）。
    var rest: str = core_clone_str(content)
    var idx: int = find(rest, old)
    while idx >= 0 {
        res += subStr(rest, 0, idx)
        res += new
        rest = subStr(rest, idx + core_str_len(old))
        if once {
            break
        }
        idx = find(rest, old)
    }
    ret res + rest
}

// ============================ 切分 ============================

fun split(content: str, del: str, keepDel: bool = false, keepEmpty: bool = false): list[str] {
    var result: list[str] = []
    // 空分隔符：按字符切开（每个字节一个元素）。
    if core_str_len(del) == 0 {
        var i: int = 0
        var n: int = core_str_len(content)
        while i < n {
            result += [_strSlice(content, i, 1)]
            i += 1
        }
        return result
    }
    // 同 replace：rest 要是拥有者，否则「一次都没切」那条路径上它仍是
    // content 的别名，最后 `result += [rest]` 会把借用存进容器（D9 规则 C）。
    var rest: str = core_clone_str(content)
    var delLen: int = core_str_len(del)
    while true {
        var idx: int = find(rest, del)
        if idx < 0 {
            break
        }
        var front: str = subStr(rest, 0, idx)
        if core_str_len(front) > 0 || keepEmpty {
            result += [front]
        }
        if keepDel {
            // `del` 是形参 = 借用，借用不能存进容器（D9 规则 C：只有拥有者
            // 才能被移动/存入）。这里要的是「分隔符本身的一份独立副本」，
            // 显式 clone 正好是规范 §11 给的手段。
            result += [core_clone_str(del)]
        }
        rest = subStr(rest, idx + delLen)
    }
    if core_str_len(rest) > 0 || keepEmpty {
        result += [rest]
    }
    ret result
}

fun chunk(content: str, num: int): list[str] {
    var res: list[str] = []
    if num <= 0 {
        return res
    }
    var index: int = 0
    var contentSize: int = core_str_len(content)
    while index + num <= contentSize {
        res += [_strSlice(content, index, num)]
        index += num
    }
    if index < contentSize {
        res += [_strSlice(content, index, contentSize - index)]
    }
    ret res
}

// ============================ 修剪 ============================

// 判断字节 b 是否在 extraChars 里。
fun _strHasByte(s: str, b: int): bool {
    var n: int = core_str_len(s)
    var i: int = 0
    while i < n {
        if s[i] == b {
            return true
        }
        i += 1
    }
    ret false
}

fun trim(content: str, extraChars: str = " ", onLeft: bool = true, onRight: bool = true): str {
    var n: int = core_str_len(content)
    if n == 0 {
        ret ""
    }
    var startIndex: int = 0
    var endIndex: int = n - 1
    if onLeft {
        while startIndex < n && _strHasByte(extraChars, content[startIndex]) {
            startIndex += 1
        }
    }
    if onRight {
        while endIndex >= startIndex && _strHasByte(extraChars, content[endIndex]) {
            endIndex -= 1
        }
    }
    if endIndex < startIndex {
        ret ""
    }
    ret _strSlice(content, startIndex, endIndex - startIndex + 1)
}

export(size, toStr, toChar, charToInt, intToChar, intToStr, floatToStr,
    subStr, find, toLowerCase, toUpperCase, replace, split, chunk, trim)
