fun rt_eprint_int(v: int): void extern
fun rt_eprint_bool(v: int): void extern
fun rt_eprint_null(): void extern
fun rt_eprint_str(s: ptr): void extern
fun rt_eprint_float(v: float): void extern
fun rt_eprint_ptr(v: int): void extern
fun rt_eprint_char(v: int): void extern
fun rt_pow10(n: int): int extern
fun rt_pow16(n: int): int extern
fun rt_argv_init(argc: int, argv: ptr): ptr extern
