/*
 * ds —— 容器（list / dict）操作模块
 *
 * ============================ 实现约束（重要） ============================
 * 新架构是静态的、值内联的，没有装箱、没有运行期类型标签、没有解引用运算符。
 * 这决定了本模块的实现手段：
 *
 *  1) **core 层没有「读内存」原语**。只有 mem_copy / mem_move / mem_set / mem_eq
 *     和 alloc / free。要读某个地址的 8 字节整数，只能「伪造一个 str 头」：
 *     把临时缓冲区的长度头写成 8，mem_copy 把目标地址的 8 字节搬到缓冲区
 *     +8 处，再把缓冲区当 str，用 s[i] 逐字节读（char → int 是无符号的）。
 *     见 _dsLoadI64。这是遍历 dict 内部数组的唯一手段。
 *
 *  2) **list 原地追加可行（P13-1 起）**。`emitIndexAssignValue` 在写元素前有
 *     越界检查（cmp (%rcx),%rax / jae skip），所以手工把长度头改大之后
 *     `xs[n] = v` 仍会被跳过 —— 但 ABI v2 把 header 与 data 分开之后，
 *     core 层可以同时改长度头与 data 指针，于是追加下沉到
 *     `core_list_append`（原地、header 地址不变，见 D6 + D12）。
 *     **原地删除同样可行**（左移覆盖 + 缩短长度头），listRemove 用它。
 *
 *  3) **没有 for-in**。`for x in xs` / `for k in d` 都是语法错误，
 *     一律用 while + 下标。
 *
 *  4) **闭包不能写回外层变量**（G6 延期到 P13）。所以 iter / forInRange
 *     不能靠回调累加，本模块不提供 iter（由 map / filter / forInRange 覆盖），
 *     forInRange 的回调只做副作用。
 *
 *  5) `list[int]` 与 `list[str]` 不能重载分派（元素类型在 mangling 里被擦除，
 *     报「重复定义」），所以凡是按元素类型区分的函数一律用泛型 `[T]`。
 *
 * ============================ 布局常量（ABI v2，P13-1）============================
 * 三个容器统一「len@0, cap@8」，header 与 data 分离（docs/p13_plan.md D11/D12）：
 *   StrHeader  { i64 len@0, i64 cap@8,  u8 data@16 }
 *   ListHeader { i64 len@0, i64 cap@8,  i64 elem_size@16, ptr data@24 }
 *   DictHeader { i64 len@0, i64 cap@8,  ptr keys@16,       ptr vals@24 }
 *   三者长度都在 +0，所以 _dsLen(arg: any) 对 str/list/dict 通用。
 *   cap == 0 表示静态只读头（str 字面量），不可释放（D11）。
 *   元素/键/值槽恒 8 字节。
 *   dict 的键值数组都是 8 字节槽的**线性数组**，遍历顺序 = 插入顺序。
 * ==========================================================================
 */

// `join` 要把任意元素转成 str，只能靠 str 模块的 `toStr` 重载（泛型做不到
// 类型分派，见文件头第 5 条）。模块是编译期内联的，这里不 import 的话，
// 用户只 `import ds` 时 `toStr` 不可见 —— `join` 会编译失败（P12-3-D 实测：
// `Assignment to 'r': cannot assign a value of type int to a target of type str`）。
// 用户同时 import ds 和 str 时符号重复内联是允许的（同名同签名合并），不会冲突。
import(sm="str")

// ============================ 内部工具 ============================
//
// 模块私有辅助函数一律带 `_ds` 前缀：模块是编译期内联的，被 import 的
// 模块语句会原地展开到导入者的同一命名空间里，不加前缀会与其它模块撞名。

// 逐字节写 8 字节小端长度头。
// core_mem_set(p, n, 1) 只写 n 的低 8 位，长度 > 255 会截断，必须逐字节写。
fun _dsSetLen(p: ptr, n: int): void {
    var i: int = 0
    while i < 8 {
        core_mem_set(p + i, (n / _dsPow256(i)) % 256, 1)
        i += 1
    }
}

fun _dsPow256(k: int): int {
    var r: int = 1
    var i: int = 0
    while i < k {
        r = r * 256
        i += 1
    }
    ret r
}

// 读 addr 处 8 字节小端整数。
//
// 没有解引用运算符，core 层也没有读内存的原语，所以这里伪造一个 str 头：
// scratch 的前 8 字节写成「长度 8」，接着 mem_copy 搬 8 字节进来，然后把
// scratch 当 str 用 s[i] 逐字节读。scratch 由调用方分配并复用（每次调用
// 都 alloc 会泄漏，本模块不调用 core_free）。
fun _dsLoadI64(scratch: ptr, addr: ptr): int {
    _dsSetLen(scratch, 8)
    // ABI v2：伪造的 str 头也是 {len@0, cap@8, data@16}
    core_mem_copy(scratch + 16, addr, 8)
    var s: str = scratch
    var r: int = 0
    var i: int = 7
    while i >= 0 {
        var c: char = s[i]
        var b: int = c
        r = r * 256 + b
        i -= 1
    }
    ret r
}

// 分配一块可复用的 64 字节读缓冲（16 字节头 + 8 字节数据，留余量）。
fun _dsScratch(): ptr {
    ret core_alloc(64, 8)
}

// 在 dict 的键数组里线性查找 key，返回下标；找不到返回 -1。
//
// 键类型是泛型 `[T]`：dict 的键**不限于 str**（dict[int, …] / dict[float, …]
// / dict[char, …] 都是一等公民，2026-11-17 实测全部可用）。
//
// **不能用「重载 + 泛型」派发键比较**（实测踩过）：在泛型体内部，`T` 还是
// 占位符，重载决议会选中泛型版 `_dsKeyMatch[T]`（T 与 T 精确匹配），
// str 特化版永远选不到 —— 结果 str 键退化成比指针，查不到。
//
// 正确写法：**不让泛型体碰键比较**，把「取槽值」与「比键」分成两个入口，
// 由调用方（已知具体键类型）挑。这里给两个顶层函数：
//   * `_dsKeyIndexRaw(d, slot)`     —— str 键：槽里是 str 指针，按内容比
//   * `_dsKeyIndexScalar(d, val)`   —— 标量键：槽里就是值，按值比
// 两者都是**非泛型**的，内部比较指令在发射时就定死了。
fun _dsKeyIndexOfStr(d: dict, key: str): int {
    var scratch: ptr = _dsScratch()
    var n: int = core_str_len(d)
    var keys: ptr = _dsLoadI64(scratch, d + 16)
    var i: int = 0
    while i < n {
        var kp: int = _dsLoadI64(scratch, keys + i * 8)
        // 槽里存的是 str 指针的位模式：经 ptr 中转还原成 str（直接
        // `var ks: str = kp` 会被标注校验拦下 —— 那不是转换而是位复用）
        var kptr: ptr = kp
        var ks: str = kptr
        if ks == key {
            return i
        }
        i += 1
    }
    ret -1
}

fun _dsKeyIndexOfScalar(d: dict, key: int): int {
    var scratch: ptr = _dsScratch()
    var n: int = core_str_len(d)
    var keys: ptr = _dsLoadI64(scratch, d + 16)
    var i: int = 0
    while i < n {
        if _dsLoadI64(scratch, keys + i * 8) == key {
            return i
        }
        i += 1
    }
    ret -1
}

// 8 字节槽的线性数组里，把 [idx+1, n) 左移一格覆盖 idx，共 tail 个元素。
fun _dsShiftLeft(base: ptr, idx: int, tail: int): void {
    if tail <= 0 {
        ret
    }
    core_mem_move(base + idx * 8, base + (idx + 1) * 8, tail * 8)
}

// ============================ 长度与判空 ============================

// 字节长度。str / list / dict 的长度字段都在偏移 0，所以对三者通用。
//
// 形参必须标 `any`：不标注会被当成 int，传 str 时在调用点就报
// "cannot assign a value of type str to a target of type int"。
//
// **带 `_ds` 前缀且不导出**：`str.rio` 已经导出了同名同签名的 `size`。
// 两个模块同时被 import 时，模块是编译期内联的，两份 `size` 会进同一命名
// 空间被当成重载，而 `any` 形参在重载决议里会退化成 int，导致
// `_dsLen(list[int])` 报 "cannot assign list[int] to int"。实测确认。
fun _dsLen(arg: any): int {
    ret core_str_len(arg)
}

/**
 * 判断容器是否为空。
 *
 * 内部统一实现：对 list / dict / str 三种容器均通过 `_dsLen` 获取长度，
 * 长度为 0 即视为空。
 *
 * 注意：
 * 1. 这里本可以用泛型来消除重复的三个重载，但当前泛型不支持类型约束
 *    （无法约束为“仅 list / dict / str”），若用无约束泛型，
 *    类型检查会退化得和 `any` 一样宽，等于没有约束。
 *    因此暂时选择用重载显式枚举 list / dict / str，
 *    在调用侧保留精确的类型检查，代价是少量模板代码。
 *    TODO: 待语言支持泛型约束后，此处应改为带约束的泛型实现，合并三个重载，去掉重复的模板代码。
 *
 * 2. 不直接暴露接收 `any` 的接口，同样是为了避免 `any` 过度放宽类型检查。
 * 3. 本模块不导出 `size`，长度计算统一使用 `str` 模块导出的 `size`
 *    （str/list/dict 通用），避免两个模块同时被 import 时内联产生命名冲突。
 *
 * @example
 * isEmpty([]) == true
 * isEmpty([1]) == false
 * isEmpty({}) == true
 * isEmpty("") == true
 */
fun _dsIsEmpty(arg: any): bool {
    ret _dsLen(arg) == 0
}

/** 判断 str 是否为空。@example isEmpty("") == true */
fun isEmpty(arg: str): bool {
    ret _dsIsEmpty(arg)
}

/** 判断 list 是否为空。@example isEmpty([]) == true */
fun isEmpty(arg: list): bool {
    ret _dsIsEmpty(arg)
}

/** 判断 dict 是否为空。@example isEmpty({}) == true */
fun isEmpty(arg: dict): bool {
    ret _dsIsEmpty(arg)
}

// ============================ 取元素 ============================

/**
 * 取列表末元素。空列表返回元素类型的默认值（int/float 是 0，str 是 ""）。
 *
 * @example top([1,2,3]) == 3
 */
fun top[T](xs: list[T]): T {
    var n: int = _dsLen(xs)
    if n == 0 {
        // 不能写 `var zero: T = xs[0]`：空列表的元素区没有有效数据，
        // 读到的是堆上的未初始化字节。对 T=str 就是一个野指针，
        // 后续参与拼接/比较直接段错误（P12-3-D 实测 exit -1073741819）。
        // 未初始化的 `var zero: T` 才是元素类型的零值（int 0 / float 0.0 /
        // bool false / str null，而 null 按空串处理），与文档口径一致。
        var zero: T
        ret zero
    }
    ret xs[n - 1]
}

// ============================ 拷贝 ============================

/**
 * 深拷贝：新列表与源完全独立（header 与 data 都是新分配的）。
 *
 * P13-1 起委托 `core_clone_list` —— 容器自身（header + data 块）独立，
 * 但**元素槽仍是浅复制**：逐元素判断「这个槽是 int 还是 str 指针」需要
 * 运行期类型标签，而本架构是静态的、无标签（D14 的口径，等 P13-4）。
 * 所以 `copy([[1,2]])` 的内层列表仍与源共享。
 *
 * @example copy([1,2,3]) 得到等值且独立的列表
 */
fun copy[T](xs: list[T]): list[T] {
    var r: list[T] = core_clone_list(xs)
    ret r
}

// ============================ 重复构造 ============================

/**
 * 重复字符串 times 次。times <= 0 返回 ""。
 *
 * @example repStr("ab", 3) == "ababab"
 */
fun repStr(s: str, times: int): str {
    var r: str = ""
    var i: int = 0
    while i < times {
        r = r + s
        i += 1
    }
    ret r
}

/**
 * 用同一个元素重复构造列表。times <= 0 返回空列表。
 *
 * @example repList(7, 3) == [7,7,7]
 */
fun repList[T](x: T, times: int): list[T] {
    var r: list[T] = []
    var i: int = 0
    while i < times {
        r += [x]
        i += 1
    }
    ret r
}

// ============================ 增删 ============================

/**
 * 追加元素，**原地修改**列表（P13-1 / D6 裁决 A 起恢复旧版语义）。
 *
 * 实现委托 `core_list_append`：ABI v2 把 header 与 data 分开之后，
 * 扩容只改写 header 里的 data 指针，**header 地址不变** —— 所以调用方的
 * 变量、其他拷贝、形参里的 list 全都仍然有效（D12 的承诺）。
 * 这也正是原地追加必须放在 core 层的原因：codegen 的索引写有越界检查，
 * std 层没法「先改长度头再写」。
 *
 * 返回 void 而非 list：header 地址不变意味着返回值毫无信息量，而返回
 * header 指针会诱使调用方把它当「新列表」赋值（两者在 ABI 上是同一个字，
 * 语义却完全不同）。
 *
 * 扩容失败（OOM）时啥也不做，长度不变。
 *
 * @example listAppend([1,2], 3) 之后列表变成 [1,2,3]
 */
fun listAppend[T](xs: list[T], item: T): void {
    core_list_append(xs, item)
}

/**
 * 按下标删除元素，**原地修改**列表并缩短长度。
 *
 * 实现是「后续元素左移一格覆盖 + 长度减 1」。不释放被删元素占用的堆数据
 * （`core_free` 尚未接通，见文档 §6）。下标越界时不做任何事。
 *
 * 这符合内存模型的「销毁点在调用处、位置静态已知」——被删元素的销毁点
 * 就是这一行。
 *
 * @example listRemove([1,2,3], 1) 之后列表变成 [1,3]
 */
fun listRemove[T](xs: list[T], index: int): void {
    var n: int = _dsLen(xs)
    if index < 0 || index >= n {
        ret
    }
    // ABI v2：list 的 data 是 header+24 处的独立指针。
    // 没有解引用运算符，只能经 _dsLoadI64 读那 8 字节（它内部用 scratch）。
    var scratch: ptr = _dsScratch()
    var base: ptr = _dsLoadI64(scratch, xs + 24)
    _dsShiftLeft(base, index, n - index - 1)
    _dsSetLen(xs, n - 1)
}

/**
 * 按键删除字典条目，**原地修改**。键不存在时不做任何事。
 *
 * 键类型覆盖 str 与标量：dict 的键不限于 str（int / float / char 都可，
 * 2026-11-17 实测）。两个重载都是**非泛型**的，内部比较方式在发射时
 * 就定死 —— 泛型版在泛型体内选不到 str 特化（见 _dsKeyIndexOfStr 的注释）。
 *
 * 键数组与值数组是两个独立的线性数组，各左移一格后长度减 1。
 * 不释放被删键值占用的堆数据（同上）。
 *
 * @example dictRemove({"a":1,"b":2}, "a") 之后只剩 {"b":2}
 */
fun dictRemove(d: dict, key: str): void {
    _dsDictRemoveAt(d, _dsKeyIndexOfStr(d, key))
}

/** 标量键版本（int / float / char / bool）。@example dictRemove({1:"x"}, 1) */
fun dictRemove(d: dict, key: int): void {
    _dsDictRemoveAt(d, _dsKeyIndexOfScalar(d, key))
}

// 按下标删除键值对（两个 dictRemove 的公共尾巴）。
fun _dsDictRemoveAt(d: dict, idx: int): void {
    if idx < 0 {
        ret
    }
    var scratch: ptr = _dsScratch()
    var n: int = core_str_len(d)
    var keys: ptr = _dsLoadI64(scratch, d + 16)
    var vals: ptr = _dsLoadI64(scratch, d + 24)
    var tail: int = n - idx - 1
    _dsShiftLeft(keys, idx, tail)
    _dsShiftLeft(vals, idx, tail)
    _dsSetLen(d, n - 1)
}

// ============================ 字典视图 ============================

// 从 8 字节槽还原一个 str 键：槽里是指针位模式，经 ptr 中转。
// 直接 `var ks: str = slot` 会被标注校验拦下 —— 那不是值转换而是位复用。
fun _dsSlotToStr(slot: int): str {
    var kp: ptr = slot
    var ks: str = kp
    ret ks
}

/**
 * 取字典的全部键，顺序与插入顺序一致。
 *
 * 键类型是泛型 `[K]`：dict 的键**不限于 str**（int / float / char 都可，
 * 2026-11-17 实测）。原先签名写死 `list[str]`，int 键会被当成地址解引用
 * —— 实测 `dictKeys({7:"x"})` 取不回 7。
 *
 * 实现要点：8 字节槽的原始位模式用 `int` 读出，再直接装进 `list[K]`。
 * 这里**不能**写 `var k: K = slot` —— K 实例化成 str 时会被标注校验拦下
 * （"cannot assign int to str"），而 `r += [slot]` 是往容器里塞一个
 * 8 字节槽，不做类型转换，两种 K 都成立（实测 int / str 均可）。
 *
 * 空字典推不出 K，需要显式写 `dictKeys[int]({})`（泛型推导的固有限制）。
 *
 * @example dictKeys({"a":1,"b":2}) 得到 ["a","b"]；dictKeys({7:"x"}) 得到 [7]
 */
fun dictKeys[K](d: dict[K, any]): list[K] {
    var r: list[K] = []
    var scratch: ptr = _dsScratch()
    var n: int = core_str_len(d)
    var keys: ptr = _dsLoadI64(scratch, d + 16)
    var i: int = 0
    while i < n {
        r += [_dsLoadI64(scratch, keys + i * 8)]
        i += 1
    }
    ret r
}

/**
 * 取字典的全部值，顺序与插入顺序一致。
 *
 * 返回**弱类型** `list`，同 dictKeys。值槽恒 8 字节：int/bool 是内联值，
 * float 是 double 位模式，str/list/dict 是指针。
 *
 * @note 返回的 list 中的元素为“弱类型”槽位，调用方需依据 key 的原始类型
 *       自行解释；若需强类型结果，应由上层封装或在未来专门的类型转换库中处理。
 *
 * @example dictValues({"a":1,"b":2}) 得到 [1,2]
 */
fun dictValues(d: dict): list {
    var r: list = []
    var scratch: ptr = _dsScratch()
    var n: int = core_str_len(d)
    var vals: ptr = _dsLoadI64(scratch, d + 24)
    var i: int = 0
    while i < n {
        var v: int = _dsLoadI64(scratch, vals + i * 8)
        r += [v]
        i += 1
    }
    ret r
}

// ======================== 数据类型转换 ========================

/**
 * 将 list 容器转换为字符串表示，形如 "[a, b, c]"。
 *
 * 元素通过 toStr 逐个序列化；元素之间以 ", " 分隔。
 *
 * @note 未来类型转换（如 int/float/bool 与 str 互转、弱类型槽位的解释等）
 *       将统一放到专门的类型转换库文件中，本函数只负责拼接与格式化。
 */
fun dumpToStr[T](container: list[T]): str {
    var n = size(container), res = "["
    for ({var i = 0; i < n; i ++}) {
        res += toStr(container[i])
        if i < n - 1 {
            res += ", "
        }
    }
    ret res + "]"
}

/**
 * 将 dict 容器转换为字符串表示，形如 "{k1: v1, k2: v2}"。
 *
 * 通过 dictKeys 取得按插入顺序排列的 key，再逐个取 value 并 toStr 序列化；
 * 键值对之间以 ", " 分隔。
 *
 * @note 未来类型转换（如 key/value 的弱类型槽位解释、数值与字符串互转等）
 *       将统一放到专门的类型转换库文件中，本函数只负责拼接与格式化。
 */
fun dumpToStr[T, K](container: dict[T, K]): str {
    var dks = dictKeys(container),
        n = size(dks), res = "{"
    for ({var i = 0; i < n; i ++}) {
        var key: T = dks[i]
        res += toStr(key) + ": " + toStr(container[key])
        if i < n - 1 {
            res += ", "
        }
    }
    ret res + "}"
}

/**
 * 将 bool 转换为 float：true -> 1.0，false -> 0.0。
 *
 * @note 这是临时的显式转换辅助函数；后续所有类型转换（含 bool/int/float
 *       与字符串、弱类型槽位之间的转换）会迁移到专门的类型转换库文件中。
 */
fun toFloat(arg: bool): float {
    if arg {
        ret 1.0
    } else {
        ret 0.0
    }
}

/**
 * 将 int 转换为 float（隐式提升为双精度）。
 *
 * @note 这是临时的显式转换辅助函数；后续所有类型转换（含 bool/int/float
 *       与字符串、弱类型槽位之间的转换）会迁移到专门的类型转换库文件中。
 */
fun toFloat(arg: int): float {
    ret arg + 0.0
}

// ============================ 查找 ============================

/**
 * 列表是否包含某元素（按 `==` 比较，str 按内容比）。
 *
 * @example contains([1,2,3], 2) == true
 */
fun contains[T](xs: list[T], t: T): bool {
    var i: int = 0
    while i < _dsLen(xs) {
        if xs[i] == t {
            return true
        }
        i += 1
    }
    ret false
}

/**
 * 查找元素下标，找不到返回 -1。
 *
 * @example indexOf([1,2,3], 3) == 2，indexOf([1], 9) == -1
 */
fun indexOf[T](xs: list[T], t: T): int {
    var i: int = 0
    while i < _dsLen(xs) {
        if xs[i] == t {
            return i
        }
        i += 1
    }
    ret -1
}

// ============================ 变换 ============================

/**
 * 逐元素变换，返回新列表。
 *
 * 回调必须是纯函数（不能写回外层变量，G6 延期）。
 *
 * @example map([1,2,3], (v: int) -> { ret v * 2 }) 得到 [2,4,6]
 */
fun map[T](xs: list[T], h: func[T][T]): list[T] {
    var r: list[T] = []
    var i: int = 0
    while i < _dsLen(xs) {
        r += [h(xs[i])]
        i += 1
    }
    ret r
}

/**
 * 逐元素筛选，返回新列表。
 *
 * @example filter([1,2,3,4], (v: int) -> { ret v % 2 == 0 }) 得到 [2,4]
 */
fun filter[T](xs: list[T], h: func[T][bool]): list[T] {
    var r: list[T] = []
    var i: int = 0
    while i < _dsLen(xs) {
        if h(xs[i]) {
            r += [xs[i]]
        }
        i += 1
    }
    ret r
}

/**
 * 逆序，返回新列表。
 *
 * @example reverse([1,2,3]) 得到 [3,2,1]
 */
fun reverse[T](xs: list[T]): list[T] {
    var r: list[T] = []
    var i: int = _dsLen(xs) - 1
    while i >= 0 {
        r += [xs[i]]
        i -= 1
    }
    ret r
}

/**
 * 切片，左闭右开 `[start, end)`。自动夹到合法范围，start >= end 返回空列表。
 *
 * @example slice([1,2,3,4], 1, 3) 得到 [2,3]
 */
fun slice[T](xs: list[T], start: int, end: int): list[T] {
    var r: list[T] = []
    var n: int = _dsLen(xs)
    var lo: int = start
    var hi: int = end
    if lo < 0 {
        lo = 0
    }
    if hi > n {
        hi = n
    }
    var i: int = lo
    while i < hi {
        r += [xs[i]]
        i += 1
    }
    ret r
}

/**
 * 拼接两个列表，返回新列表。
 *
 * @example concat([1,2], [3]) 得到 [1,2,3]
 */
fun concat[T](a: list[T], b: list[T]): list[T] {
    var r: list[T] = a
    var i: int = 0
    while i < _dsLen(b) {
        r += [b[i]]
        i += 1
    }
    ret r
}

/**
 * 整数列表求和。空列表返回 0。
 *
 * @example sum([1,2,3]) == 6
 */
fun sum(xs: list[int]): int {
    var r: int = 0
    var i: int = 0
    while i < _dsLen(xs) {
        r = r + xs[i]
        i += 1
    }
    ret r
}

// ============================ 排序 ============================

/**
 * 排序，返回新列表。默认升序，`reverse = true` 时降序。
 *
 * 插入排序 + 泛型单态化：`[T]` 在调用点按实参类型实例化，int/str/float
 * 各自生成一份比较代码。不能用 `list[int]` / `list[str]` 重载分派
 * （元素类型在 mangling 里被擦除，会报重复定义）。
 *
 * 稳定性：插入排序是稳定的，相等元素的相对顺序保持不变。
 *
 * @example sort([3,1,2]) 得到 [1,2,3]；sort([3,1,2], true) 得到 [3,2,1]
 */
fun sort[T](xs: list[T], reverse: bool = false): list[T] {
    var r: list[T] = xs
    var n: int = _dsLen(r)
    var i: int = 1
    while i < n {
        var key: T = r[i]
        var j: int = i - 1
        var go: bool = false
        if reverse {
            if r[j] < key {
                go = true
            }
        } else {
            if r[j] > key {
                go = true
            }
        }
        while j >= 0 && go {
            r[j + 1] = r[j]
            j -= 1
            if j >= 0 {
                go = false
                if reverse {
                    if r[j] < key {
                        go = true
                    }
                } else {
                    if r[j] > key {
                        go = true
                    }
                }
            }
        }
        r[j + 1] = key
        i += 1
    }
    ret r
}

// ============================ 拼接成字符串 ============================

/**
 * 把列表元素用分隔符拼成一个字符串。空列表返回 ""。
 *
 * 元素用 `toStr` 转换，所以 int/float/bool/str/char 都能拼。
 *
 * @example join([1,2,3], "-") == "1-2-3"
 */
fun join[T](xs: list[T], sep: str = ""): str {
    var r: str = ""
    var n: int = _dsLen(xs)
    var i: int = 0
    while i < n {
        r = r + toStr(xs[i])
        if i < n - 1 {
            r = r + sep
        }
        i += 1
    }
    ret r
}

// ============================ 遍历（副作用） ============================

/**
 * 重复调用回调 times 次，回调收到当前下标。
 *
 * **回调不能写回外层变量**（G6 延期到 P13）。需要累加时用 `sum` /
 * `map` / `filter`，它们返回新值而不是靠回调改外层。
 *
 * @example repeat(3, (i: int) -> { sout(i) }) 打印 0 1 2
 */
fun repeat(times: int, h: func[int][void]): void {
    var i: int = 0
    while i < times {
        h(i)
        i += 1
    }
}

/**
 * 从 start 到 end（左闭右开）按步长 sep 遍历，回调收到当前值。
 *
 * 旧版回调签名是 `(value, isFirst, isLast)`，但那依赖闭包写回与运行期
 * 首尾判断。新版简化为 `h(i)`：需要首尾判断时自己按下标算。
 * 步长为 0 时直接返回，避免死循环；步长为负时要求 start > end。
 *
 * @example forInRange(0, 3, (i: int) -> { sout(i) }) 打印 0 1 2
 */
fun forInRange(start: int, end: int, h: func[int][void], sep: int = 1): void {
    if sep == 0 {
        ret
    }
    var i: int = start
    if sep > 0 {
        while i < end {
            h(i)
            i += sep
        }
    } else {
        while i > end {
            h(i)
            i += sep
        }
    }
}

export(isEmpty, top, copy, repStr, repList, listAppend, listRemove,
    dictRemove, dictKeys, dictValues, dumpToStr, toFloat, contains, indexOf, map, filter,
    reverse, slice, concat, sum, sort, join, repeat, forInRange)
