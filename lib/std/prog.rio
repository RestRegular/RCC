/*
 * prog —— 程序执行控制
 *
 * 原仓库 API 面（Lib/builtin/prog.rio）：entry、breakpoint
 *
 * G1b（2026-11-20 裁决，A+B 混合）：
 *   - entry：编译期「入口文件守卫」——文件当主程序运行时执行回调，
 *     被 import 时 no-op（等价 Python 的 if __name__ == "__main__"）。
 *     回调的 *args / **kwargs 来自**调用点写死的实参**（像旧 rcc_entry），
 *     **不自动填充 argv**。
 *   - args()：新增内建，返回进程命令行参数 list[str]（不含程序名），
 *     出生地 in global 进程级；argv 由 rt 构造器在 main 入口转换。
 */

/**
 * 入口回调注册（编译期守卫）。
 *
 * 在主程序文件里调用：把 `args...`（调用点实参）转发给 `arg` 回调。
 * 在被 import 的模块里调用：no-op（零副作用）。
 *
 * @param arg   回调函数（函数值，签名与 args... 匹配）
 * @param args  转发给回调的位置实参
 */
fun entry(arg: any, *args: any): void {
}

/**
 * 进程命令行参数（不含程序名 argv[0]）。
 *
 * 返回值是 list[str]，出生地 in global（进程级，永久存活不释放）。
 * 无参时返回空 list。特殊字符按 OS 命令行规则，Rio 不二次解析。
 */
fun args(): list {
}

/**
 * 触发调试断点（空操作，见原注释）。
 */
fun breakpoint(): void {
}

export(entry, args, breakpoint)
