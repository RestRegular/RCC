/*
 * prog —— 程序执行控制
 *
 * 原仓库 API 面（Lib/builtin/prog.rio）：entry、breakpoint
 *
 * ⚠️ `entry` 的 argv 通道**尚未设计**（P12 §4.2.3 登记待设计，Q1–Q8 未裁决）。
 * 原仓库 `rcc_entry` 只实现了「编译期判断当前文件是不是入口文件」这一半，
 * argv → `*args` / `**kwargs` 那一半从来没有代码。因此这里：
 *   * 保留函数名与形参形状，让既有调用点仍能编译；
 *   * 函数体是**空实现**，不假装能拿到 argv（写死一个空列表冒充 argv 是
 *     更糟的反模式：调用方会以为拿到了真实参数）。
 * 设计定案后在这里补齐。
 */

/**
 * 入口回调注册（**待设计，当前为空实现**）。
 *
 * 设计意图：文件被当作主程序运行时，把命令行参数作为 `*args` / `**kwargs`
 * 传给 `arg`；被 import 时什么都不做。argv → 回调的映射规则（Q1–Q8）
 * 尚未裁决，因此本函数当前不做任何事。
 *
 * @param arg     回调函数，签名应为 `(*args, **kwargs) -> void`
 * @param args    传给回调的位置参数
 * @param kwargs  传给回调的关键字参数
 */
fun entry(arg, *args, **kwargs): void {
}

/**
 * 触发调试断点。
 *
 * **当前是空操作**，与原仓库在「非调试模式」下的行为一致：
 * 原仓库 `ri_breakpoint`（RioKit `rvm_ris.cpp:1348`）只有在 RVM 的交互式
 * 调试模式打开时才打印 `[Breakpoint]` 并挂起，否则直接返回成功。
 *
 * 新架构没有等价的调试器集成，所以唯一存在的执行模式就是原仓库的
 * 「非调试模式」—— 这里保持空操作才是**语义忠实**。
 *
 * ⚠️ 不要用 `core_sys_breakpoint()` 实现：它底层是 `int3`，在没有调试器
 * 附着时会让进程以 `0x80000003`（STATUS_BREAKPOINT）终止，那是比原行为
 * 更糟的回归（实测 `-2147483645`）。调试器集成若要做，需单独设计并审批。
 */
fun breakpoint(): void {
}

export(entry, breakpoint)
