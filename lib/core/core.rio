/*
 * core.rio —— RCC Runtime 种子层（Seed Layer）冻结 ABI v1
 *
 * ============================ 重要约定 ============================
 * 本文件是编译器唯一认识的「魔法文件」。它是 Compiler / Runtime /
 * Standard Library 三层之间唯一的契约，必须保持极小。
 *
 * 判断标准：只有「Rio 语言本身无法表达」或「必须直接触碰 OS」的
 * 能力才允许出现在这里。任何能用 Rio 写出来的东西，一律下沉到 rt。
 *
 * 任何签名变更都必须同时提升 ABI 版本号，并同步修改 core_win64.s。
 *
 * 实现：core_win64.s（汇编）+ 少量 core_win64.c
 * 平台：Windows x64（MS x64 ABI）
 * =================================================================
 */

// ============================ ABI 版本 ============================
// 布局或调用约定变化时必须递增
// ABI_VERSION = 1

// ============================ 内存 ================================
// 原始字节操作。语义与 C 的 memcpy / memmove / memset / memcmp 一致。

extern fun mem_copy(dst: ptr, src: ptr, n: int): void
extern fun mem_move(dst: ptr, src: ptr, n: int): void
extern fun mem_set(dst: ptr, byte: int, n: int): void
extern fun mem_eq(a: ptr, b: ptr, n: int): bool

// 分配器入口。返回 null 表示失败（不 panic，由 rt 决定如何处理）。
// align 必须是 2 的幂。
extern fun alloc(size: int, align: int): ptr
extern fun realloc(p: ptr, old_size: int, size: int, align: int): ptr
extern fun free(p: ptr): void

// ==================== P13-1：受控的原地追加（D6 / D12）====================
//
// 为什么必须是 core 层内建、而不是在 std 里用现有原语拼出来：
// 列表的长度头在容器内，而 codegen 的索引写有边界检查（`xs[n] = v` 会先比
// 长度头，越界直接跳过）。所以「先把长度头改大再写」这条路走不通 —— 实测
// 跳过写入、元素根本没进去。原地追加必须由能同时改长度头与 data 指针的
// 代码完成，std 层拿不到这个能力。
//
// D12 的前提已具备：header 与 data 分离，所以扩容只改写 header 里的
// data 指针，header 地址不变 —— 调用者的变量、拷贝、形参都不会悬空。
//
// 签名：core_list_append(xs: list, value) —— 原地追加，无返回值。
//
// 为什么**不**返回 list：header 地址不变是 D12 的承诺，所以返回值毫无
// 信息量；返回 header 指针反而会诱使调用方把它当成「新列表」去赋值，
// 而 header 指针与 list 值在 ABI 上是同一个字，语义却完全不同。
// 参数用裸 `list`（元素类型不约束），这样 list[int] / list[str] 都能传。
//
// 扩容失败时**啥也不做**（长度不变）。P13-1 的失败语义是「尽力」，
// 因为返回 void 无法上报；真有 OOM 需求时再改签名，不在此处提前设计。
// 参数 value 用 ptr：元素槽恒 8 字节，而 ptr 与数值族互通（P12/G12）、
// 也与 str/list/dict 同属指针族，所以 int / char / bool / str / 容器指针
// 都能传进来，不用为每种元素类型各写一份。
extern fun core_list_append(xs: list, value: ptr): void

// ==================== P13-1：深拷贝（clone）====================
//
// 与 ds.copy 的区别：ds.copy 是**浅拷贝**，元素指针原样复制，两个容器共享
// 元素；clone 复制容器自身（header + data 块），改一方不影响另一方。
//
// 元素槽仍是浅复制：逐元素判断「这个槽是 int 还是 str 指针」需要运行期
// 类型标签，而本架构是静态的、无标签（D14 的口径，等 P13-4）。
//
// 为什么 P13-1 需要它：严格借用规则拦下了 `ret 形参` 这类恒等函数，而
// clone 是让 std 能合法「把借用转成自己拥有的新值」的手段 —— 不需要放宽
// 任何规则，也不需要造近似。
extern fun core_clone_list(xs: list): list
extern fun core_clone_str(s: str): str

// ============================ IO ==================================
// 文件描述符约定：0 = stdin, 1 = stdout, 2 = stderr
// 返回实际读写的字节数；负数表示错误。

extern fun io_write(fd: int, buf: ptr, n: int): int
extern fun io_read(fd: int, buf: ptr, n: int): int
extern fun io_flush(fd: int): void

// ============================ 进程 ================================
extern fun proc_exit(code: int): void
extern fun proc_abort(): void

// 写 stderr 后终止。msg 不需要以 0 结尾，长度由 len 指定。
extern fun panic_raise(msg: ptr, len: int): void

// ==================== P14-1a：结构化并发运行时地基 ====================
// 仅运行时原语，不含任何语言层 scope/spawn 语义（那些在编译器里实现）。
// thread_create：创建 OS 线程，入口 fn(arg)，返回线程句柄（ptr，失败返回 null）。
// thread_join：等待线程结束并回收句柄；传 null 直接返回。
// 名字带 core_ 前缀、与 core_win64.s 符号逐字一致（新后端用源码名直接做符号）。
extern fun core_thread_create(fn: ptr, arg: ptr): ptr
extern fun core_thread_join(handle: ptr): void

// ============================ 栈探测 ==============================
// Windows 上栈帧超过 4KB 时必须探测 guard page，否则会踩空。
// 由编译器在函数序言里自动插入，不暴露给用户代码。
extern fun stack_probe(size: int): void

// ============================ 异常帧链 ============================
// 采用显式帧链（setjmp/longjmp 风格），而非表驱动 unwind。
// 代价：析构不保证执行；换来的是实现简单、可预测。

extern fun eh_push(frame: ptr): ptr
extern fun eh_pop(frame: ptr): void
extern fun eh_throw(exc: ptr): void

// ============================ 杂项 ================================
extern fun time_ns(): int
extern fun sys_breakpoint(): void

// ==================== P13-1 调试钩子（D17，仅调试构建）====================
// 只用于验证「作用域末确实释放了」这类不可从外部观察的性质。
// 发布构建里 codegen 不引用它们，计数恒为 0，不影响任何产物行为。
//
// 计数口径：
//   core_dbg_allocations() —— alloc 成功的次数
//   core_dbg_frees()       —— 真正落到 HeapFree 的次数
//                             （nullptr 与 cap==0 的静默返回**不算**释放，
//                               否则计数器证明不了任何事）
//
// 名字带 `core_` 前缀：与 core_win64.s 里的符号**逐字一致**。
// core.rio 里的 extern 名不会被自动加前缀（std 里也是直接写
// `core_alloc(...)` 调用的），所以这里必须写全名。
extern fun core_dbg_reset(): void
extern fun core_dbg_allocations(): int
extern fun core_dbg_frees(): int
// D17 的另外两个钩子：
//   core_dbg_double_frees() —— 被检测到的重复释放次数。
//     实现是在「最近释放过的 16 个指针」里查重，命中就**不再真的释放**，
//     只计数返回。这样「同一块释放两次」从不可读的堆损坏（0xC0000374）
//     变成可断言的数字。
//   core_dbg_poison_bytes() —— 释放前填 0xDD 的总字节数。块大小用
//     HeapSize 问 Windows，不靠容器头里的 len/cap（那是逻辑长度，
//     不是堆块大小）。
extern fun core_dbg_double_frees(): int
extern fun core_dbg_poison_bytes(): int

// ==================== P13-6：Pool 三档真实分配器（Q1=A）====================
// 池头固定 48 字节、地址稳定；槽位惰性分配（Pool 无类型参数，elem_size 只在
// pool.new[T] 时才知道）。三档共用块链，fixed 满时 core_pool_alloc 返回 null。
extern fun core_pool_new(mode: int, cap: int): ptr
extern fun core_pool_alloc(pool: ptr, elem_size: int): ptr
extern fun core_pool_release(pool: ptr, slot: ptr): void
// P14-3：Pool 枚举原语（par_each / pool.at）
extern fun core_pool_count(pool: ptr): int
extern fun core_pool_slot_at(pool: ptr, index: int): ptr

// ==================== P14-4：显式同步运行时原语 ====================
// 自旋锁（锁字 4 字节：0=未锁，1=已锁；xchg 隐含全屏障）
extern fun core_lock_acquire(lockword: ptr): void
extern fun core_lock_release(lockword: ptr): void
// 原子：i64 返回值按 int（64 位）使用；i32 返回值只在低 32 位，
// codegen 负责 movslq 符号扩展。全部顺序一致。
extern fun core_atomic_load_i64(addr: ptr): int
extern fun core_atomic_store_i64(addr: ptr, value: int): void
extern fun core_atomic_fetch_add_i64(addr: ptr, value: int): int
extern fun core_atomic_swap_i64(addr: ptr, value: int): int
extern fun core_atomic_cas_i64(addr: ptr, expected: int, new_value: int): int
extern fun core_atomic_fetch_op_i64(addr: ptr, value: int, op: int): int
extern fun core_atomic_load_i32(addr: ptr): int
extern fun core_atomic_store_i32(addr: ptr, value: int): void
extern fun core_atomic_fetch_add_i32(addr: ptr, value: int): int
extern fun core_atomic_swap_i32(addr: ptr, value: int): int
extern fun core_atomic_cas_i32(addr: ptr, expected: int, new_value: int): int
extern fun core_atomic_fetch_op_i32(addr: ptr, value: int, op: int): int

// ==================== P14-5：Chan 有界通道运行时原语 ====================
// 对象布局 48B 头 + cap*8 槽；一把自旋锁保护全部字段；满/空时解锁让出重试。
// core_chan_new(capacity<=0) 用默认容量 16；返回值是指针（失败则 abort）。
// core_chan_send 在已关闭通道上调用会 abort；core_chan_recv 在空且关闭时返回 null。
// core_chan_drop 只释放通道对象本身，不递归释放残留载荷（无元素类型信息）。
extern fun core_chan_new(capacity: int): ptr
extern fun core_chan_send(ch: ptr, value: ptr): void
extern fun core_chan_recv(ch: ptr): ptr
extern fun core_chan_close(ch: ptr): void
extern fun core_chan_drop(ch: ptr): void

// ==================== P13-7：Link 成对引用原语 ====================
// 全局边表维护成对关系（a.L 含 b ⟺ b.L' 含 a）。field 参数是编译期分配的
// Link 字段索引。所有原语两端同步，用户代码拿不到单边接口。
extern fun core_link_add(pool: ptr, a: ptr, aField: int, b: ptr, bField: int): void
extern fun core_link_remove(pool: ptr, a: ptr, aField: int, b: ptr, bField: int): void
extern fun core_link_clear(pool: ptr, a: ptr, aField: int, bField: int): void
extern fun core_link_unlink_all(pool: ptr, a: ptr): void
extern fun core_link_is_empty(a: ptr): int
extern fun core_link_count(a: ptr, field: int): int
extern fun core_link_has(a: ptr, field: int, peer: ptr): int
